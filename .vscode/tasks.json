{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile All Java Files",
            "type": "shell",
            "command": "javac",
            "args": [
                "-cp", "src",
                "-d", "build/classes",
                "src/**/*.java"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Run AccessModifiersDemo",
            "type": "shell",
            "command": "java",
            "args": [
                "-cp", "build/classes",
                "src.oop.AccessModifiersDemo"
            ],
            "group": "test",
            "dependsOn": "Compile All Java Files",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Run PolymorphismDemo",
            "type": "shell",
            "command": "java",
            "args": [
                "-cp", "build/classes",
                "src.oop.PolymorphismDemo"
            ],
            "group": "test",
            "dependsOn": "Compile All Java Files",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Generate JavaDoc",
            "type": "shell",
            "command": "javadoc",
            "args": [
                "-d", "docs/javadoc",
                "-cp", "src",
                "-sourcepath", "src",
                "-subpackages", "src"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Clean Build",
            "type": "shell",
            "command": "rm",
            "args": [
                "-rf", "build/classes", "docs/javadoc"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        }
    ]
}
